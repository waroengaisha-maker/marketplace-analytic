:8080 {
	@vite path /@vite/* /@id/* /@fs/* /resources/* /node_modules/* /__vite_ping

	header @vite {
		Access-Control-Allow-Origin "http://localhost:8080"
		Access-Control-Allow-Methods "GET, OPTIONS, POST, PUT, PATCH, DELETE"
		Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization"
		Access-Control-Allow-Credentials "true"
	}

	reverse_proxy @vite laravel.test:5173

	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}

	reverse_proxy @websocket laravel.test:5173

	# Cloudflare Tunnel connects to Caddy over HTTP, while the public app is HTTPS.
	# Preserve the original scheme for Laravel redirects and URL generation.
	@appHost host marketplace-analytics.my.id
	reverse_proxy @appHost laravel.test:80 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host marketplace-analytics.my.id
		header_up X-Forwarded-Port 443
	}

	reverse_proxy laravel.test:80
}

(services-auth) {
	forward_auth laravel.test:80 {
		uri /_internal/service-auth
		header_up Host marketplace-analytics.my.id
	}
}

http://netdata.marketplace-analytics.my.id:8080 {
	import services-auth
	reverse_proxy netdata:19999
}

http://portainer.marketplace-analytics.my.id:8080 {
	import services-auth

	reverse_proxy https://portainer:9443 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

http://adminer.marketplace-analytics.my.id:8080 {
	import services-auth
	reverse_proxy adminer:8080
}

http://redisinsight.marketplace-analytics.my.id:8080 {
	import services-auth
	reverse_proxy redisinsight:5540
}
